ord","overall_status":"finished","participant_count":2,"recid":127990,"record":{"abstract":"A measurement of the top quark pole mass $m_\\mathrm{t}^\\text{pole}$ in events where a top quark-antiquark pair ($\\mathrm{t\\bar{t}}$) is produced in association with at least one additional jet ($\\mathrm{t\\bar{t}}$+jet) is presented. This analysis is performed using proton-proton collision data at $\\sqrt{s}$ = 13 TeV collected by the CMS experiment at the CERN LHC, corresponding to a total integrated luminosity of 36.3 fb$^{-1}$. Events with two opposite-sign leptons in the final state (e$^+$e$^-$, $\\mu^+\\mu^-$, e$^\\pm\\mu^\\mp$) are analyzed. The reconstruction of the main observable and the event classification are optimized using multivariate analysis techniques based on machine learning. The production cross section is measured as a function of the inverse of the invariant mass of the $\\mathrm{t\\bar{t}}$+jet system at the parton level using a maximum likelihood unfolding. Given a reference parton distribution function (PDF), the top quark pole mass is extracted using the theoretical predictions at next-to-leading order. For the ABMP16NLO PDF, this results in $m_\\mathrm{t}^\\text{pole}$ = 172.93 $\\pm$ 1.36 GeV.","access_urls":{"links":{"csv":"https://www.hepdata.net/download/submission/ins2106483/2/csv","json":"https://www.hepdata.net/download/submission/ins2106483/2/json","root":"https://www.hepdata.net/download/submission/ins2106483/2/root","yaml":"https://www.hepdata.net/download/submission/ins2106483/2/yaml","yoda":"https://www.hepdata.net/download/submission/ins2106483/2/yoda"}},"analyses":[],"arxiv_id":"arXiv:2207.02270","collaborations":["CMS"],"control_number":"127990","creation_date":"2022-07-05","data_abstract":"Measurement of the top quark pole mass using $\\text{t}\\overline{\\text{t}}\\text{+jet}$ events in the dilepton final state in proton-proton collisions at$\\sqrt{s}=$ 13 TeV. A measurement of the top quark pole mass $m_{\\text{t}}^{\\text{pole}}$ in events where a top quark-antiquark pair ($\\text{t}\\overline{\\text{t}}$) is produced in association with at least one additional jet ($\\text{t}\\overline{\\text{t}}$+jet) is presented. This analysis is performed using proton-proton collision data at $\\sqrt{s}=$ 13 TeV collected by the CMS experiment at the CERN LHC, corresponding to a total integrated luminosity of 36.3fb$^{-1}$. Events with two opposite-sign leptons in the final state ($\\text{e}^{+}\\text{e}^{-}$, $\\mu^{+}\\mu^{-}$, $\\text{e}^{\\pm}\\mu^{\\mp}$) are analyzed. The reconstruction of the main observable and the event selection are optimized using multivariate analysis techniques based on machine learning. The production cross section is measured as a function of the inverse of the invariant mass of the $\\text{t}\\overline{\\text{t}}$+jet system at the parton level using a maximum likelihood unfolding. Given a reference parton distribution function (PDF), the top quark pole mass is extracted using the theoretical predictions at next-to-leading order. For the ABMP16NLO PDF, this results in $m_{\\text{t}}^{\\text{pole}}=172.94\\pm1.37$.","data_keywords":{"cmenergies":[{"gte":13000.0,"lte":13000.0}],"observables":["DSIG/DRHO"],"phrases":["Proton-Proton Scattering","Cross Section","Differential Cross Section","Top"],"reactions":["P P --> TQ TQBAR JET"]},"doc_type":"publication","doi":"10.1007/JHEP07(2023)077","first_author":{"affiliation":"Yerevan Phys. Inst.","full_name":"Tumasyan, Armen"},"hepdata_doi":"10.17182/hepdata.127990.v2","id":127990,"inspire_id":"2106483","journal_info":"JHEP 07 (2023) 077","keywords":[{"source":"author","value":"Hadron-Hadron Scattering"},{"source":"author","value":"Top Physics"},{"schema":"INSPIRE","value":"p p: colliding beams"},{"schema":"INSPIRE","value":"top: pair production"},{"schema":"INSPIRE","value":"jet: associated production"},{"schema":"INSPIRE","value":"mass: pole"},{"schema":"INSPIRE","value":"parton: distribution function"},{"schema":"INSPIRE","value":"p p: scattering"},{"schema":"INSPIRE","value":"top: mass: measured"},{"schema":"INSPIRE","value":"final state: ((n)jet dilepton)"},{"schema":"INSPIRE","value":"electron"},{"schema":"INSPIRE","value":"muon"},{"schema":"INSPIRE","value":"quark antiquark: pair"},{"schema":"INSPIRE","value":"channel cross section: measured"},{"schema":"INSPIRE","value":"perturbation theory: higher-order"},{"schema":"INSPIRE","value":"higher-order: 1"},{"schema":"INSPIRE","value":"CERN Lab"},{"schema":"INSPIRE","value":"CERN LHC Coll"},{"schema":"INSPIRE","value":"CMS"},{"schema":"INSPIRE","value":"data analysis method"},{"schema":"INSPIRE","value":"experimental results"},{"schema":"INSPIRE","value":"13000 GeV-cms"},{"schema":"PDG","value":"Q007TP4"}],"last_updated":"Tue, 26 Mar 2024 16:30:27 GMT","parent_child_join":{"name":"parent_publication"},"publication_date":"2023-05-07T00:00:00","recid":127990,"resources":[],"subject_area":["hep-ex"],"summary_authors":[{"affiliation":"Yerevan Phys. Inst.","full_name":"Tumasyan, Armen"},{"affiliation":"Vienna, OAW","full_name":"Adam, Wolfgang"},{"affiliation":"Vienna, OAW","full_name":"Andrejkovic, Janik Walter"},{"affiliation":"Vienna, OAW","full_name":"Bergauer, Thomas"},{"affiliation":"Vienna, OAW","full_name":"Chatterjee, Suman"},{"affiliation":"Vienna, OAW","full_name":"Damanakis, Konstantinos"},{"affiliation":"Vienna, OAW","full_name":"Dragicevic, Marko"},{"affiliation":"Vienna, OAW","full_name":"Escalante Del Valle, Alberto"},{"affiliation":"Vienna, OAW","full_name":"Hussain, Priya Sajid"},{"affiliation":"Vienna, OAW","full_name":"Jeitler, Manfred"}],"title":"Measurement of the top quark pole mass using $\\mathrm{t\\bar{t}}$+jet events in the dilepton final state in proton-proton collisions at $\\sqrt{s}$ = 13 TeV","type":["article"],"uuid":"19e0e5e8-7187-452e-9cc0-5e3d706958d1","version":2,"year":"2023"},"record_type":"publication","related_recids":[],"related_to_this_recids":[],"resources_with_doi":[],"reviewers_notified":false,"